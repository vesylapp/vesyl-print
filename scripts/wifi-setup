#!/usr/bin/python3
"""Root helper: NetworkManager hotspot / scan / connect for vesyl-print.

Installed as /usr/local/lib/vesyl-print/wifi-setup
Sudoers: vesyl ALL=(root) NOPASSWD: /usr/local/lib/vesyl-print/wifi-setup
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

# The modules below come from the release slot, which the service user owns.
# Running as root, Python would leave root-owned __pycache__ there that the
# agent can never delete; the portal this spawns inherits the same setting.
sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"

if sys.version_info < (3, 9):
    sys.stderr.write("wifi-setup requires Python 3.9+\n")
    raise SystemExit(2)

# Fixed, never taken from the caller. setup.sh rewrites this line when it
# installs the helper for a non-default INSTALL_ROOT.
INSTALL_ROOT = Path("/opt/vesyl-print")

CANDIDATES = (
    INSTALL_ROOT / "current",
    Path(__file__).resolve().parents[1],
)
for root in CANDIDATES:
    if (root / "wifi_setup.py").is_file():
        sys.path.insert(0, str(root))
        break

import wifi_setup  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(wifi_setup.main())
