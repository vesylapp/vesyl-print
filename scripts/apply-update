#!/usr/bin/env bash
# Root helper for vesyl-print OTA install steps.
# Install:  sudo install -m 0755 scripts/apply-update /usr/local/lib/vesyl-print/apply-update
# Sudoers:  vesyl ALL=(root) NOPASSWD: /usr/local/lib/vesyl-print/apply-update
#
# Usage:
#   apply-update activate <release_dir> <current_symlink>
#   apply-update restart
#   apply-update rollback <install_root> <version>
#
# The sudoers rule lets the service user run this as root with any arguments,
# so no argument is trusted as a path. The install root is fixed below;
# activate accepts only <install_root>/releases/<version> and
# <install_root>/current, rollback only <install_root> and <version>, and the
# only thing ever written is the symlink <install_root>/current ->
# releases/<version> (through <install_root>/current.new). <version> must match
# the release version pattern (so it is never "." or ".." and has no "/"), and
# its slot must be a real directory (not a symlink) holding an agent entrypoint.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

# Fixed, never taken from the caller. An install under a non-default root
# needs this line rewritten when the helper is installed.
INSTALL_ROOT=/opt/vesyl-print
# Same pattern as update.py _VERSION_RE / update.rs is_version.
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$'
# Same as update.rs SLOT_ENTRYPOINTS.
ENTRYPOINTS=(agent.py main.py vesyl-print bin/vesyl-print)

die() {
  echo "apply-update: $*" >&2
  exit 1
}

usage() {
  echo "Usage: $0 activate <release_dir> <current_symlink> | restart | rollback <install_root> <version>" >&2
  exit 2
}

if [[ $EUID -ne 0 ]]; then
  echo "apply-update must run as root" >&2
  exit 1
fi

# Point $INSTALL_ROOT/current at releases/<version>, atomically.
activate_version() {
  local version="$1"
  [[ "$version" =~ $VERSION_RE ]] || die "invalid release version: $version"
  local releases="$INSTALL_ROOT/releases"
  local release_dir="$releases/$version"
  [[ -d "$releases" && ! -L "$releases" ]] || die "not a directory: $releases"
  [[ -d "$release_dir" && ! -L "$release_dir" ]] || die "missing release_dir: $release_dir"
  local entry found=""
  for entry in "${ENTRYPOINTS[@]}"; do
    if [[ -f "$release_dir/$entry" ]]; then
      found=1
      break
    fi
  done
  [[ -n "$found" ]] || die "release $version has no agent entrypoint (${ENTRYPOINTS[*]})"

  local current_link="$INSTALL_ROOT/current"
  local tmp="$INSTALL_ROOT/current.new"
  # -T: never treat an existing current.new (e.g. a symlink to a directory)
  # as a directory to create the link inside; -n: do not follow it.
  ln -sfnT "releases/$version" "$tmp"
  mv -Tf "$tmp" "$current_link"
  echo "activated $release_dir -> $current_link"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  activate)
    [[ $# -eq 2 ]] || usage
    release_dir="$1"
    current_link="$2"
    [[ "$current_link" == "$INSTALL_ROOT/current" ]] ||
      die "current_symlink must be $INSTALL_ROOT/current, not: $current_link"
    prefix="$INSTALL_ROOT/releases/"
    [[ "$release_dir" == "$prefix"* ]] ||
      die "release_dir must be $prefix<version>, not: $release_dir"
    activate_version "${release_dir#"$prefix"}"
    ;;
  restart)
    [[ $# -eq 0 ]] || usage
    # --no-block: agent calls this to restart itself; waiting would hang until
    # SIGTERM and look like an OTA failure to the parent process.
    # Restart display *before* agent so LCD always loads the new slot even if
    # the agent unit stop races this script.
    systemctl restart --no-block vesyl-print-display.service || true
    systemctl restart --no-block vesyl-print-agent.service || true
    echo "restarted services"
    ;;
  rollback)
    [[ $# -eq 2 ]] || usage
    install_root="$1"
    version="$2"
    # Tolerate a trailing slash from a hand-typed path, nothing else.
    [[ "$install_root" == "$INSTALL_ROOT" || "$install_root" == "$INSTALL_ROOT/" ]] ||
      die "install_root must be $INSTALL_ROOT, not: $install_root"
    activate_version "$version"
    ;;
  *)
    usage
    ;;
esac
