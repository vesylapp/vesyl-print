# setup.sh installs this unit with User= set to the service account and
# /opt/vesyl-print replaced by its INSTALL_ROOT.
[Unit]
Description=VESYL Print — cloud agent (heartbeat / pairing / OTA)
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=vesyl
WorkingDirectory=/opt/vesyl-print/current
ExecStart=/opt/vesyl-print/current/vesyl-print agent
Restart=on-failure
RestartSec=5
# Do not put secrets in Environment= lines.
Environment=VESYL_PRINT_INSTALL_ROOT=/opt/vesyl-print

[Install]
WantedBy=multi-user.target
